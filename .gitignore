__pycache__/
*.pyc
.venv/
venv/

# Everything below lives on the cluster's shared filesystem, never in git:
#   /mnt/data/qwen38-demo/{models,datasets,output,results,logs}
#
# NOTE: `models/` is deliberately NOT ignored. It used to be, to keep downloaded
# weights out of git -- but the repo now has models/<name>/ for model *code*,
# and that rule silently excluded models/qwen3.8-27b/model.py from a commit.
# Nothing downloads into the repo (download.sh writes to $DEMO_DIR), so the
# rule was protecting against something that cannot happen here.
logs/
output/
datasets/
*.out
*.err
